# Copie este arquivo para ".env" e preencha os valores locais.
# Nunca versione o arquivo ".env" (ele já está no .gitignore).

# --- PostgreSQL (banco oficial do sistema) ---
DATABASE_BACKEND=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=transito_ia
DATABASE_USER=postgres
DATABASE_PASSWORD=

# --- Acesso (modo multi-cliente) ---
# Com DATABASE_BACKEND=postgres o login é por e-mail e senha (contas por organização,
# ver scripts/gerenciar_contas.py). Defina uma chave fixa para as sessões sobreviverem a reinícios:
FLASK_SECRET_KEY=
# Só vale no modo local sem PostgreSQL (senha única opcional do painel):
VIA_ACCESS_PASSWORD=

# --- Assistente de IA (opcional; o sistema funciona sem nenhuma delas,
#     caindo automaticamente para respostas por template sem LLM) ---
AI_PROVIDER=gemini
# Chave gratuita: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Alternativa 100% local/offline (trocar AI_PROVIDER=ollama para usar):
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
